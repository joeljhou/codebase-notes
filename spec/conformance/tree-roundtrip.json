{
  "operation": "roundtrip-config",
  "cases": [
    {
      "id": "tree/metadata-root-and-orphans",
      "input": {
        "config": {
          "$schema": "./spec/codebase-notes.schema.json",
          "version": 3,
          "rootFuture": {
            "__proto__": {
              "kept": true
            },
            "notes": [
              null,
              false,
              1.5
            ]
          },
          "notes": {
            "_text": "项目",
            "_meta": {
              "style": "default",
              "future": [
                null,
                {
                  "text": "opaque"
                }
              ]
            },
            "src": {
              "_text": "源代码",
              "_meta": {
                "style": "core"
              },
              ".vuepress": {
                "config.ts": {
                  "_text": "配置",
                  "_meta": {
                    "future": {
                      "_text": "not structure",
                      "_meta": {},
                      "__proto__": "保留"
                    }
                  }
                },
                "path": {
                  "_text": "路径",
                  "navbar.ts": "导航栏"
                }
              }
            },
            "empty": "空目录",
            "missing": {
              "deep": {
                "same.ts": "不存在的路径"
              }
            },
            "other": {
              "same.ts": "另一个同名文件"
            }
          }
        }
      },
      "expected": {
        "notes": {
          ".": {
            "text": "项目",
            "style": "default",
            "future": [
              null,
              {
                "text": "opaque"
              }
            ]
          },
          "src": {
            "text": "源代码",
            "style": "core"
          },
          "src/.vuepress/config.ts": {
            "text": "配置",
            "future": {
              "_text": "not structure",
              "_meta": {},
              "__proto__": "保留"
            }
          },
          "src/.vuepress/path": {
            "text": "路径"
          },
          "src/.vuepress/path/navbar.ts": {
            "text": "导航栏"
          },
          "empty": {
            "text": "空目录"
          },
          "missing/deep/same.ts": {
            "text": "不存在的路径"
          },
          "other/same.ts": {
            "text": "另一个同名文件"
          }
        }
      }
    },
    {
      "id": "tree/escaped-filenames-and-prototype-keys",
      "input": {
        "config": {
          "version": 3,
          "__proto__": {
            "keep": true
          },
          "notes": {
            "_text": "根备注",
            "__text": {
              "_text": "真实 _text",
              "__meta": "_text/_meta"
            },
            "__meta": {
              "_text": "真实 _meta",
              "_meta": {
                "style": "focus",
                "text-like": {
                  "text": "x"
                }
              }
            },
            "___text": "真实 __text",
            "__": "真实下划线",
            "___proto__": {
              "_text": "原型名",
              "_meta": {
                "__proto__": {
                  "enabled": true
                }
              }
            },
            "constructor": "构造器名",
            "prototype": "prototype",
            "toString": "toString",
            "hasOwnProperty": "hasOwnProperty",
            "2": "two",
            "10": "ten",
            "text": "普通 text 文件",
            "中文 😀": {
              "space name.ts": "  多行\n备注  "
            },
            "unannotated-empty": {}
          }
        }
      },
      "expected": {
        "notes": {
          ".": {
            "text": "根备注"
          },
          "_text": {
            "text": "真实 _text"
          },
          "_text/_meta": {
            "text": "_text/_meta"
          },
          "_meta": {
            "text": "真实 _meta",
            "style": "focus",
            "text-like": {
              "text": "x"
            }
          },
          "__text": {
            "text": "真实 __text"
          },
          "_": {
            "text": "真实下划线"
          },
          "__proto__": {
            "text": "原型名",
            "__proto__": {
              "enabled": true
            }
          },
          "constructor": {
            "text": "构造器名"
          },
          "prototype": {
            "text": "prototype"
          },
          "toString": {
            "text": "toString"
          },
          "hasOwnProperty": {
            "text": "hasOwnProperty"
          },
          "2": {
            "text": "two"
          },
          "10": {
            "text": "ten"
          },
          "text": {
            "text": "普通 text 文件"
          },
          "中文 😀/space name.ts": {
            "text": "  多行\n备注  "
          }
        }
      }
    },
    {
      "id": "tree/config-filename-as-structural-parent",
      "input": {
        "config": {
          "version": 3,
          "notes": {
            ".codebase-notes.json": {
              "child": "保留既有合法路径"
            }
          }
        }
      },
      "expected": {
        "notes": {
          ".codebase-notes.json/child": {
            "text": "保留既有合法路径"
          }
        }
      }
    },
    {
      "id": "tree/compacted-and-nested-prefixes",
      "input": {
        "config": {
          "version": 3,
          "rootFuture": {
            "kept": true
          },
          "notes": {
            "src/main/java": {
              "cn/geekyspace/app": {
                "integration": "集成测试",
                "unit": {
                  "_text": "单元测试",
                  "_meta": {
                    "style": "focus",
                    "custom": [
                      null,
                      true
                    ]
                  }
                }
              }
            },
            "src": {
              "other": "其他"
            },
            "__private/__text/cn.example": {
              "README.md": "文件名"
            },
            "missing/deep/file.ts": "失联"
          }
        }
      },
      "expected": {
        "notes": {
          "src/main/java/cn/geekyspace/app/integration": {
            "text": "集成测试"
          },
          "src/main/java/cn/geekyspace/app/unit": {
            "text": "单元测试",
            "style": "focus",
            "custom": [
              null,
              true
            ]
          },
          "src/other": {
            "text": "其他"
          },
          "_private/_text/cn.example/README.md": {
            "text": "文件名"
          },
          "missing/deep/file.ts": {
            "text": "失联"
          }
        }
      }
    }
  ]
}
