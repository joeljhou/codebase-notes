{
  "operation": "parse-config",
  "cases": [
    {
      "id": "parse/minimal-v3",
      "input": {
        "text": "{\"version\":3,\"notes\":{}}"
      },
      "expected": {
        "mode": "writable"
      }
    },
    {
      "id": "parse/all-note-styles",
      "input": {
        "text": "{\"version\":3,\"notes\":{\"a\":{\"_text\":\"A\",\"_meta\":{\"style\":\"default\"}},\"b\":{\"_text\":\"B\",\"_meta\":{\"style\":\"important\"}},\"c\":{\"_text\":\"C\",\"_meta\":{\"style\":\"focus\"}},\"d\":{\"_text\":\"D\",\"_meta\":{\"style\":\"core\"}},\"e\":{\"_text\":\"E\",\"_meta\":{\"style\":\"stable\"}},\"f\":{\"_text\":\"F\",\"_meta\":{\"style\":\"extension\"}}}}"
      },
      "expected": {
        "mode": "writable"
      }
    },
    {
      "id": "parse/note-style",
      "input": {
        "text": "{\"version\":3,\"notes\":{\"a\":{\"_text\":\"A\",\"_meta\":{\"style\":\"danger\"}}}}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/bom",
      "input": {
        "text": "﻿{\"version\":3,\"notes\":{}}"
      },
      "expected": {
        "mode": "writable"
      }
    },
    {
      "id": "parse/future-version",
      "input": {
        "text": "{\"version\":4,\"futureShape\":true}"
      },
      "expected": {
        "mode": "readonly-future",
        "code": "CBN002_FUTURE_VERSION"
      }
    },
    {
      "id": "parse/duplicate-key",
      "input": {
        "text": "{\"version\":3,\"notes\":{},\"notes\":{}}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/trailing-comma",
      "input": {
        "text": "{\"version\":3,\"notes\":{},}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/unsafe-integer",
      "input": {
        "text": "{\"version\":3,\"notes\":{},\"future\":9007199254740992}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/negative-zero",
      "input": {
        "text": "{\"version\":3,\"notes\":{},\"future\":-0}"
      },
      "expected": {
        "mode": "writable"
      }
    },
    {
      "id": "parse/exponent",
      "input": {
        "text": "{\"version\":3,\"notes\":{},\"future\":1e2}"
      },
      "expected": {
        "mode": "writable"
      }
    },
    {
      "id": "parse/non-finite-exponent",
      "input": {
        "text": "{\"version\":3,\"notes\":{},\"future\":1e400}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/decimal-version",
      "input": {
        "text": "{\"version\":3.0,\"notes\":{}}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/exponent-version",
      "input": {
        "text": "{\"version\":3e0,\"notes\":{}}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    },
    {
      "id": "parse/unsafe-version",
      "input": {
        "text": "{\"version\":9007199254740992,\"notes\":{}}"
      },
      "expected": {
        "mode": "invalid",
        "code": "CBN001_INVALID_CONFIG"
      }
    }
  ]
}
